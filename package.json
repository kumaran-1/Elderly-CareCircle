{
  "name": "carecircle",
  "version": "0.1.0",
  "private": true,
  "description": "CareCircle MVP backend for elderly-care workflows, alerts, AI safety, and reporting.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:core": "tsx src/tests/core-flow.ts",
    "test:api": "tsx src/tests/api-flow.ts",
    "test": "npm run test:core && npm run test:api"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.4",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
